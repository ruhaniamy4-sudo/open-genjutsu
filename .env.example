# KINETIX Studio — environment
# Every block is optional. With nothing set, the site runs in Demo Mode:
# local Director compiler, simulated renders, demo credits kept in the browser.

# Public site URL (Stripe redirects, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-kinetix-site.vercel.app

# ---------------------------------------------------------------- Director Agent (first one set wins)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------- Accounts + credits (Supabase)
# Turns on sign-in, real credit balances, refunds and the synced Library.
# Run supabase/schema.sql once in the Supabase SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Partner engines (fal.ai)
# Live partner renders need Supabase billing (so visitors cannot spend your balance),
# or KINETIX_ALLOW_ANON_LIVE=true for private testing.
FAL_KEY=
KINETIX_ALLOW_ANON_LIVE=false
# Override any fal endpoint without a code change, e.g.:
# FAL_ENDPOINT_SEEDANCE_25_I2V=bytedance/seedance-2.5/image-to-video
# FAL_ENDPOINT_SEEDANCE_25_T2V=bytedance/seedance-2.5/text-to-video
# FAL_ENDPOINT_WAN_26_I2V=fal-ai/wan/v2.6/image-to-video
# FAL_ENDPOINT_WAN_26_T2V=fal-ai/wan/v2.6/text-to-video
# FAL_ENDPOINT_KLING_30_I2V / _T2V, FAL_ENDPOINT_VEO_31_I2V / _T2V

# ---------------------------------------------------------------- Job tokens
# Random string of 48+ characters. Signs job tokens (HMAC). Set it in production.
# If empty, falls back to SUPABASE_SERVICE_ROLE_KEY, then to a dev string.
KINETIX_JOB_SECRET=

# ---------------------------------------------------------------- Kinetix Pro GPU worker (Colab / Vast.ai / RunPod)
# Default worker for everyone. Leave empty to rely on per-user ?gpu= links.
KINETIX_GPU_URL=
# Must match KINETIX_BRIDGE_TOKEN printed by the Colab notebook / vast_onstart.sh.
KINETIX_GPU_TOKEN=
# Hosts a ?gpu= link may point to. A leading dot allows any subdomain.
KINETIX_GPU_ALLOWED_HOSTS=.trycloudflare.com

# ---------------------------------------------------------------- Uploads (Cloudflare R2)
# Without R2, clips and portraits stay in the browser (preview only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kinetix-renders

# ---------------------------------------------------------------- Payments (Stripe, needs Supabase)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring monthly prices: $19 Creator, $49 Pro Studio.
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=

# ---------------------------------------------------------------- Rate limits (Upstash Redis)
# Without it, limits are per server instance (best effort).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
